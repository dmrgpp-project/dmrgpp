##Ainur1.0

# Restart from a nonzero-time P-vector. startLoop keeps the clock inactive, but
# the TimeEvolve propagator must still use the source vector's physical time.
TotalNumberOfSites=8;
NumberOfTerms=1;
DegreesOfFreedom=1;
GeometryKind="chain";
GeometryOptions="ConstantValues";
dir0:Connectors=[1.0];
hubbardU=[0.0, ...];
potentialV=[0.0, ...];
Model="HubbardOneBand";
SolverOptions="restart,twositedmrg,TargetingExpression,useComplex";
RestartFilename="data123";
Version="time-evolve-start-loop-source-time";
InfiniteLoopKeptStates=50;
FiniteLoops=[
    [@auto, 150, 2],
    [@auto, 150, 2]];
RepeatFiniteLoopsTimes=1;
TargetElectronsUp=4;
TargetElectronsDown=4;
string P0=|P1>;
string P1="TimeEvolve{tau=0.1,steps=5,advanceEach=6,startLoop=100}*|P0>";
GsWeight=0.2;
OutputFile="data132";
#ci dmrg arguments= -p 12 "<P1|nup|P1>"
#ci CollectBrakets 0
