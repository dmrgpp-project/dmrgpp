##Ainur1.0

# Delayed P0 makes P1 and P2 start at different sweep sites.  This fixture
# intentionally leaves their clocks unsynchronized; the selected equal-time
# braket must reject the resulting mismatch on the second finite loop.
TotalNumberOfSites=8;
NumberOfTerms=1;
DegreesOfFreedom=1;
GeometryKind="chain";
GeometryOptions="ConstantValues";
dir0:Connectors=[1.0];
hubbardU=[0.0, ...];
potentialV=[0.0, ...];
Model="HubbardOneBand";
SolverOptions="restart,twositedmrg,TargetingExpression,useComplex";
RestartFilename="data120";
Version="time-consistency-unsynchronized";
InfiniteLoopKeptStates=50;
FiniteLoops=[
    [@auto, 150, 2],
    [@auto, 150, 2]];
TargetElectronsUp=4;
TargetElectronsDown=4;
string P0="c[3]'*|gs>";
string P1="TimeEvolve{tau=0.1,steps=5,advanceEach=6}*|gs>";
string P2="TimeEvolve{tau=0.1,steps=5,advanceEach=6}*|P0>";
GsWeight=0.2;
OutputFile="data9120";
#ci dmrg arguments= -p 12 "<P1|c|P2>"
