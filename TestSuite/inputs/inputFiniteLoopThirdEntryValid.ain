##Ainur1.0

TotalNumberOfSites = 5;
NumberOfTerms      = 1;
DegreesOfFreedom   = 1;
GeometryKind       = "chain";
GeometryOptions    = "ConstantValues";
dir0:Connectors    = [-1];
hubbardU           = [7.3, ...];
potentialV         = [0.0, ...];
Model              = "HubbardOneBand";

TargetElectronsUp   = 2;
TargetElectronsDown = 2;

InfiniteLoopKeptStates = 128;
TruncationTolerance = 1e-09;
FiniteLoops = [
    [@auto, 128, @save:@randomguess:tol=1e-09:mmin=128],
    [@auto, 128, @save:@randomguess:tol=1e-09:mmin=128],
    [@auto, 128, @save:@randomguess:tol=1e-09:mmin=128],
    [@auto, 128, @save:@randomguess:tol=1e-09:mmin=128],
    [@auto, 128, @save:@randomguess:tol=1e-09:mmin=128]
];

SolverOptions = "twositedmrg,usecomplex,geometryallinsystem";
Version = "FiniteLoopThirdEntryValid";
OutputFile = "dataFiniteLoopThirdEntryValid";
